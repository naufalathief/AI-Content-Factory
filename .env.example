# Copy to .env and fill in. Only GEMINI_API_KEY and DATABASE_URL are required.

GEMINI_API_KEY=
DATABASE_URL=postgresql+psycopg2://acf_user:acf_pass@localhost:5432/content_factory

# Used by docker-compose for the PostgreSQL container
POSTGRES_DB=content_factory
POSTGRES_USER=acf_user
POSTGRES_PASSWORD=acf_pass

# --- Optional -------------------------------------------------------------

# Narration, subtitle and YouTube metadata language (keep them the same)
# CONTENT_LANGUAGE=Native American English
# WHISPER_LANGUAGE=en

# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_MAX_RETRIES=4

# TTS_VOICE=en-US-AndrewMultilingualNeural
# TTS_RATE=+0%

# default | space | history | science | tech
# IMAGE_STYLE=default
# IMAGE_MAX_RETRIES=3

# Pollinations fallback: free tier = 1 image / 45 s; a token removes the limit
# POLLINATIONS_TOKEN=

# VIDEO_TAIL_SECONDS=0.6

# FFmpeg: defaults to tools/ffmpeg/*.exe on Windows, then the system PATH
# FFMPEG_PATH=
# FFPROBE_PATH=
